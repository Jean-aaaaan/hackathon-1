# Vantage API — Environment Variables
# Copy to .env and fill in values. Never commit .env to git.

# ── App ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL 16 with pgvector extension
DATABASE_URL=postgresql://vantage:vantage_local@localhost:5432/vantage

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:vantage_redis_local@localhost:6379/0

# ── WorkOS (Auth) ─────────────────────────────────────────────────────────────
# Get from: https://dashboard.workos.com
WORKOS_API_KEY=sk_...
WORKOS_CLIENT_ID=client_...
WORKOS_REDIRECT_URI=http://localhost:8000/auth/callback

# ── Anthropic (AI) ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Model overrides (defaults set in config.py)
# ANTHROPIC_MODEL_BULK=claude-haiku-4-5-20251001
# ANTHROPIC_MODEL_QUALITY=claude-sonnet-4-6

# ── VoyageAI (Embeddings) ─────────────────────────────────────────────────────
# Get from: https://dash.voyageai.com
VOYAGE_API_KEY=pa-...

# ── Perplexity (Web Research) ─────────────────────────────────────────────────
# Get from: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=pplx-...

# ── HubSpot (CRM) ────────────────────────────────────────────────────────────
# Get from: https://developers.hubspot.com/docs/api/creating-an-app
HUBSPOT_CLIENT_ID=...
HUBSPOT_CLIENT_SECRET=...
HUBSPOT_REDIRECT_URI=http://localhost:8000/auth/hubspot/callback

# ── Microsoft Outlook (Email Send + Read) ─────────────────────────────────────
# Required for "Approve & Send" from War Room — sends emails via rep's Outlook mailbox
# Setup:
#   1. portal.azure.com → Entra ID → App registrations → New registration
#   2. Redirect URI (Web): http://localhost:3000/auth/outlook/callback
#   3. API permissions (delegated): Mail.ReadWrite, User.Read, offline_access
#      (Mail.ReadWrite = create drafts in Drafts folder; Mail.Send NOT needed — rep sends manually)
#   4. Certificates & secrets → New client secret → copy value
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=

# ── Azure Service Bus ─────────────────────────────────────────────────────────
# For agent job queue — leave empty to use sync fallback in dev
AZURE_SERVICE_BUS_CONNECTION_STRING=

# ── Fireflies.ai (Call Transcripts) ──────────────────────────────────────────
# Get API key from: https://app.fireflies.ai/integrations/apps/api
# Webhook secret: Fireflies.ai → Settings → Webhooks → secret for HMAC verification
FIREFLIES_API_KEY=
FIREFLIES_WEBHOOK_SECRET=

# ── Microsoft Teams (Alerts) ─────────────────────────────────────────────────
# Create an incoming webhook connector in your Teams channel:
# Channel → Manage channel → Connectors → Incoming Webhook → Configure
# Paste the generated URL here. Leave empty to disable Teams alerts.
TEAMS_WEBHOOK_URL=
# Urgency threshold to trigger Teams alert (0.0-1.0, default 0.85)
TEAMS_ALERT_URGENCY_THRESHOLD=0.85

# ── Observability ─────────────────────────────────────────────────────────────
# Optional — leave empty to disable
SENTRY_DSN=
POSTHOG_API_KEY=

# ── Internal Mode ─────────────────────────────────────────────────────────────
# For single-workspace (Invigilo internal) mode
DEFAULT_WORKSPACE_ID=00000000-0000-0000-0000-000000000001
FRONTEND_URL=http://localhost:3000

# ── Auth Security ─────────────────────────────────────────────────────────────
# Secret for signing share-link and SSE-stream JWTs (generate: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SIGNING_KEY=

# Fernet key for at-rest encryption of OAuth tokens in DB (generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# Required in production — without this, tokens are stored as plaintext
FIELD_ENCRYPTION_KEY=

# WorkOS session cookie encryption password — must be ≥32 random bytes (generate: python -c "import secrets; print(secrets.token_hex(32))")
# Required in production — without this, workos_client_id is used (insecure)
WORKOS_COOKIE_SECRET=

# Dev-only bypass token (DEBUG=true required). Never set in production.
# Only works when ENVIRONMENT=development AND DEBUG=true.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
DEBUG_BYPASS_TOKEN=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Empty = use built-in defaults.
CORS_ORIGINS=

# ── Allowed Email Domains ─────────────────────────────────────────────────────
# Comma-separated list of domains for auto-provisioning (empty = allow all).
ALLOWED_EMAIL_DOMAINS=
