# Vantage Web — Environment Variables
# Copy to .env.local and fill in.

# API URL — where FastAPI runs
NEXT_PUBLIC_API_URL=http://localhost:8000

# Auth callback (must match WorkOS + FastAPI config)
# In dev: /auth/callback proxied through Next.js → FastAPI

# Dev bypass token — must match DEBUG_BYPASS_TOKEN in apps/api/.env.
# Only active when NODE_ENV=development. Leave empty in production.
NEXT_PUBLIC_DEV_BYPASS_TOKEN=
